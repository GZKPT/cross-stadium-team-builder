rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validMeta() {
      return request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.author in ['GZKPT', 'Maxter', 'Cato']
        && request.resource.data.groupKey is string
        && request.resource.data.groupKey.size() <= 40;
    }

    match /pokemon/{id} {
      allow get, list: if request.auth != null;
      allow create: if validMeta()
        && request.resource.data.keys().hasOnly(['name', 'author', 'groupKey', 'pokemon', 'ownerUid', 'createdAt'])
        && request.resource.data.pokemon is map
        && request.resource.data.pokemon.species is int
        && request.resource.data.pokemon.species >= 1
        && request.resource.data.pokemon.species <= 151
        && request.resource.data.pokemon.moves is list
        && request.resource.data.pokemon.moves.size() == 4;
      allow update, delete: if false;
    }

    match /teams/{id} {
      allow get, list: if request.auth != null;
      allow create: if validMeta()
        && request.resource.data.keys().hasOnly(['name', 'author', 'groupKey', 'pokemon', 'ownerUid', 'createdAt'])
        && request.resource.data.pokemon is list
        && request.resource.data.pokemon.size() == 6;
      allow update, delete: if false;
    }
  }
}
